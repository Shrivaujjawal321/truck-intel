# virtualenvs
.venv/
venv/

# secrets
.env

# immutable raw downloads (content-addressed, replayable, never committed)
data/raw/

# python
__pycache__/
*.pyc
.pytest_cache/

# generated (make status-page)
status.html

# OSM PBF downloads (12GB — replayable from Geofabrik, never committed)
data/pbf/
# Overture Places local mirror (11GB — replayable from the S3 release, never
# committed). scripts/mechanic_list.py --local-dir reads it; it exists only so a
# home link does not have to re-stream 11 GB per scan.
data/overture_places/
# Census CBP bulk files (replayable from www2.census.gov)
data/cbp/
# runtime pidfiles (scripts/viewer_up.sh)
data/*.pid
# WZDx discovery proposals (regenerated by scripts/wzdx_discover.py)
data/wzdx_proposed/

# generated (scripts/weekly_digest.py)
status_weekly.md

# runtime logs at data/ root (us-osm-extract.log, us-download.log, ...)
data/*.log

# generated deliverables (regenerated daily by mechanic_list.py --refresh)
data/outputs/

# osm_ways spools. The job KEEPS these deliberately after a completed phase A
# (a 3-4 h pass is worth hours; see _cleanup_workdir), so they must never be
# committed — 25 of them reached 26 GB before 2026-07-28.
data/pbf/.osmways-work-*/
