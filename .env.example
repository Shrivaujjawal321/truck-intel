# Copy to .env and edit. Never commit .env.

# Postgres connection (matches scripts/db_up.sh defaults).
# Generate a password: openssl rand -hex 24   (no default ships in this repo —
# a default in a public repo is a published password).
DATABASE_URL=postgresql://truckintel:REPLACE_ME@localhost:5432/truckintel

# EIA free API key (register at https://www.eia.gov/opendata/ — auto-emailed).
# Leave empty: the eia_diesel connector then records status='skipped_no_key'
# in ops.source_runs instead of crashing.
EIA_API_KEY=

# Sent in every outbound User-Agent header (politeness contract; NWS requires
# it, and several other sources ask for a contact). PUT A REAL ADDRESS HERE in
# your own .env — the code falls back to an obviously-unset placeholder so an
# unconfigured deployment is visible to the servers it calls rather than
# impersonating someone else.
CONTACT_EMAIL=you@example.com

# Where scripts/mechanic_list.py writes truck_mechanics.html / .json.
MECHANICS_OUT_DIR=data/outputs/mechanics

# Tracking-ingest write role, created by sql/schema_tracking.sql. Narrow by
# design: INSERT pings + UPDATE three columns of core.truck_devices, nothing
# else. sql/schema_tracking.sql ships NO password (a literal in a public repo is
# a published credential), so the role starts with an unguessable random one.
# Give it a usable password and fill this in with:
#     make rotate-track-password
# Leave it unset and the tracking write path silently falls back to the OWNER
# role — it works, but least privilege is then not actually in force.
# TRACK_DATABASE_URL=postgresql://truckintel_track:REPLACE_ME@localhost:5432/truckintel
