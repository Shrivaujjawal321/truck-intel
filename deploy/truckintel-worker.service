# truck-intel: the queue worker — drains ops.job_queue, one job at a time (MVP).
# Long-running; restarts on failure. All HTTP goes through polite_get() inside.
[Unit]
Description=truck-intel worker (fetch -> validate -> publish)
After=network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/Documents/truck-intel
# The After= line above is a no-op: neither target exists in the systemd USER
# manager, so this starts seconds after login whatever the network is doing.
# Every timer-driven job closes that gap with a wait_ready dropin; the worker
# never did, and the worker is what performs ALL the fetching. On 2026-08-18
# nine sources — ntad_parking, nws_alerts, wzdx_ks/mn/wa, caltrans d02/d03/d09
# and eia_diesel — failed inside SIX SECONDS at 07:00:48, each on "Max retries
# exceeded" against a different host. Nine hosts do not fail together; the
# resolver was not up yet.
#
# Inline rather than a dropin because the worker is deliberately excluded from
# NET_UNITS and the batch slice (it is long-running, not a timer job), so the
# gate has to travel with the unit.
ExecStartPre=%h/Documents/truck-intel/scripts/wait_ready.sh --dns --db --timeout 180
ExecStart=%h/.local/bin/uv run python -m truckintel.engine worker
Restart=on-failure
RestartSec=10

# Kernel ceilings, added 2026-07-27. `Nice`/`IOSchedulingClass` only lower
# PRIORITY — they never stop a job consuming the machine, which is what
# happened when an idle-classed OSM pass took the laptop from 11 GB free to
# 1.6 GB and had to be killed by hand. These bound a RUNAWAY; the admission
# gate in truckintel/resources.py is the first line of defence.
#
# These MUST sit inside [Service]. Appended after [Install] they parse as
# [Install] directives, systemd ignores them, and `systemctl show` reports
# MemoryMax=infinity while the unit file plainly reads MemoryMax=6G.
MemoryMax=6G
MemorySwapMax=0
CPUQuota=70%

[Install]
WantedBy=default.target

