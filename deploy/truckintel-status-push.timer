# Every 2 hours, measured from the END of the last run rather than a wall-clock
# calendar: the request was "2 ghante ke gap se", which is a gap, not a slot.
#
# Persistent=false on purpose, and it is the whole point. Every other timer here
# sets it true so a missed nightly job catches up at login. For a status digest
# catch-up is the wrong behaviour: a laptop off for eight hours would deliver
# four queued updates in one burst at login, which is noise, not news.
[Unit]
Description=truck-intel status digest timer (every 2h while armed)

[Timer]
# BOTH are 2h, and that is the fix for a real bug. This was OnActiveSec=1min
# so the first update arrived promptly after arming — but OnActiveSec counts
# from every TIMER activation, and `make install-timers` re-enables every
# timer. Running it at 18:09 on 2026-08-18 scheduled an extra update for
# 18:10, thirteen minutes after the previous one instead of two hours.
# Re-installing units must not be able to send a message.
#
# OnUnitActiveSec counts from the last time the SERVICE ran, so a manual
# `systemctl --user start truckintel-status-push.service` also resets the gap
# — which is what you want: the next one is two hours after the last one that
# actually went out, however it went out.
OnActiveSec=2h
OnUnitActiveSec=2h
AccuracySec=1m
Persistent=false

[Install]
WantedBy=timers.target
